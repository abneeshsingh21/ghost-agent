# GHOST v6.0 — Git Ignore
.env
__pycache__/
*.pyc
loot/
logs/
*.log
memory/session_context.json
/memory/*.json
/tmp/
/payloads/
ghost_payloads/
.venv
venv/

# Node / Cockpit
node_modules/
cockpit/node_modules/
cockpit/dist/

# Captured data — never commit raw pcaps or probe data
*.pcap
probe_requests.json
"probe_requests.json'"

# Temporary test directories generated during dev/testing
tmp_*/
tmp/

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
